# Proof-of-Action — environment variables
# This file is committed. .env is NEVER committed.

ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev
# endpoints and the issuer are read at runtime from /health or stellar.toml

HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

USDC_SAC_ID=                  # derived in M0
POA_CONTRACT_ID=              # after the deploy
VAULT_ADDRESS=                # optional — empty: funds stay in the escrow; set: they sit in the DeFindex vault (scripts/create-vault.sh)

RELAYER_SECRET=               # backend-only, never leaks to the frontend
RELAYER_PUBLIC=
ADMIN_SECRET=
ADMIN_PUBLIC=
COORD_A_PUBLIC=
COORD_B_PUBLIC=
COORD_C_PUBLIC=

# For the demo: coordinators sign with their own wallets in the browser.
# These secrets are only for the headless test scripts.
COORD_A_SECRET=
COORD_B_SECRET=
COORD_C_SECRET=

PUBLIC_BASE_URL=              # for on_change_callback (the Vercel URL)

# Persistent store. IF EMPTY it writes to a file (data/store.json) — which only
# works on localhost: on Vercel the file system is read-only and every request is a
# separate lambda, so a saved supplier is gone on the next request.
# Vercel Marketplace → Upstash Redis fills these two in for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=
IPFS_API_KEY=                 # optional — without it, the mock CID fallback
DONOR_SECRET=               # the demo donor (for the headless e2e)
DONOR_PUBLIC=

# When true, /api/demo-accounts hands out the testnet demo keys.
# NEVER set this to true for mainnet or a public deploy.
DEMO_MODE=false
