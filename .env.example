# Proof-of-Action — ortam değişkenleri
# Bu dosya repoya girer. .env ASLA commit edilmez.

ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev
# endpoint'ler ve issuer /health veya stellar.toml'dan runtime'da okunur

HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

USDC_SAC_ID=                  # M0'da türetilir
POA_CONTRACT_ID=              # deploy sonrası
VAULT_ADDRESS=                # opsiyonel — boşsa fon escrow'da durur; doluysa DeFindex vault'unda (scripts/create-vault.sh)

RELAYER_SECRET=               # backend-only, asla frontend'e sızmaz
RELAYER_PUBLIC=
ADMIN_SECRET=
ADMIN_PUBLIC=
COORD_A_PUBLIC=
COORD_B_PUBLIC=
COORD_C_PUBLIC=

# Demo amaçlı: coordinator'lar tarayıcıda kendi cüzdanlarıyla imzalar.
# Bu secret'lar yalnızca headless test script'leri içindir.
COORD_A_SECRET=
COORD_B_SECRET=
COORD_C_SECRET=

PUBLIC_BASE_URL=              # on_change_callback için (Vercel URL)

# Kalıcı depo. BOŞSA dosyaya yazılır (data/store.json) — bu yalnızca
# localhost'ta çalışır: Vercel'de dosya sistemi salt okunur ve her istek ayrı
# lambda, yani kaydedilen tedarikçi bir sonraki istekte yok olur.
# Vercel Marketplace → Upstash Redis bu ikisini kendisi yazar.
KV_REST_API_URL=
KV_REST_API_TOKEN=
IPFS_API_KEY=                 # opsiyonel — yoksa mock CID fallback
DONOR_SECRET=               # demo bağışçısı (headless e2e için)
DONOR_PUBLIC=
